engine-strict=true
# Svelte 5 + packages that still declare Svelte 3 peers (svelte-inview@3,
# svelte-slidy, prettier-plugin-svelte@2) and stale stylelint plugins. The
# lockfile was resolved this way; without it `npm ci` fails with ERESOLVE.
# Remove once those packages are upgraded or replaced.
legacy-peer-deps=true
