---
import Header from '$lib/Header/index.svelte';
import Footer from '$lib/Footer/index.svelte';
import { env } from 'cloudflare:workers';
import Seo from './Seo.astro';
import type { Schema } from '../utils/json-ld';
import '../../src/app.scss';
import '@fontsource/fira-mono/latin.css';
import '../lib/fonts/roboto-latin.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  pathname?: string;
  noindex?: boolean;
  isPost?: boolean;
  thumbnail?: string;
  schemas?: Schema[];
}

const { title = 'Page not found', ...seo } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" />
    <link rel="manifest" href="/manifest.json" crossorigin="use-credentials" />
    <link rel="icon" type="image/ico" href="/favicon.ico" />
    {env.TURNSTILE_SITE_KEY && <meta name="turnstile-site-key" content={env.TURNSTILE_SITE_KEY} />}
    <Seo {title} {...seo} />
    <script is:inline type="text/plain" data-defer-analytics>
       // @ts-nocheck
