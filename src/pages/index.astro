---
import SiteLayout from '../components/SiteLayout.astro';
import HomeSections from '../components/HomeSections.astro';
import { GET } from '../routes/videos/index.json.ts';
import { websiteSchema, organizationSchema, videoObjectSchema } from '../utils/json-ld';

const list = await GET();
const data = (await list.json()) as Array<{ id: string; title: string; desc: string; date: string }>;
const selectedVideos = [data[0], data[1]].filter(Boolean);
const videoSchemas = selectedVideos.map((video) => videoObjectSchema({
  id: video.id,
  title: video.title,
  description: video.desc,
  date: video.date,
  pageUrl: 'https://mailcheck.co/'
}));
---
<SiteLayout
  title="Email Verification & Validation Tool"
  description="Verify email addresses in bulk or through an API, reduce bounces, and keep your marketing lists clean with Mailcheck."
  schemas={[websiteSchema, organizationSchema, ...videoSchemas]}
>
  <HomeSections videos={selectedVideos} />
</SiteLayout>
