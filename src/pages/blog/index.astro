---
import SiteLayout from '../../components/SiteLayout.astro';
import Blog from '../../routes/blog.svelte';
import { getPublishedPosts, paginatePosts } from '../../routes/blog/_blog';
import type { IPost } from '$utils/types';
import { websiteSchema, blogSchema } from '../../utils/json-ld';

const { posts, totalPages } = paginatePosts((await getPublishedPosts()) as IPost[], 1);
const title = 'Blog about effective email checking & communication';
const description = 'Blog about building effective b2b and b2c email communications: guides and templates, trends & best practices, tips & tricks';
const canonicalPath = '/blog';
---
<SiteLayout {title} {description} canonical={canonicalPath} schemas={[websiteSchema, { ...blogSchema, url: 'https://mailcheck.co/blog', name: title, description }]}>
  <Fragment slot="head">
    {totalPages > 1 && <link rel="next" href="https://mailcheck.co/blog/2" />}
  </Fragment>
  <Blog client:load {posts} page={1} {totalPages} />
</SiteLayout>
