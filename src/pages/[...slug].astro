---
import SiteLayout from '../components/SiteLayout.astro';
import ArticleLayout from '../lib/MdLayouts/ArticleLayout.svelte';
import FaqLayout from '../lib/MdLayouts/FaqLayout/FaqLayout.svelte';
import ContactUs from '../lib/ContactUs/index.svelte';
import Blog from '../routes/blog.svelte';
import Video from '../lib/Video/video.svelte';
import { marked, Renderer } from 'marked';
import GithubSlugger from 'github-slugger';
import { websiteSchema, blogSchema, webPageSchema, blogPostingSchema, faqPageSchema, breadcrumbListSchema, videoObjectSchema } from '../utils/json-ld';
import NotFound from '../routes/404.svelte';
import { getCmsDocument, usesCms } from '../server/cms-content';
import { sanitizeMarkdown } from '../server/markdown-security';
import mediaManifest from '../../seed/media.json';
import { imageUrl } from '../server/media-images';
import data from '../utils/site-data';
import { getPublishedPosts, getRelatedPosts, paginatePosts } from '../routes/blog/_blog';
import type { IPost } from '$utils/types';

const slug = Astro.params.slug ?? '';
if (slug === 'blog/1') return Astro.redirect('/blog', 301);
const blogPageNumber = Number(slug.match(/^blog\/([1-9]\d*)$/)?.[1] ?? NaN);
const blogPageData = Number.isInteger(blogPageNumber)
  ? paginatePosts((await getPublishedPosts()) as IPost[], blogPageNumber)
  : null;
const isBlogArchive = !!blogPageData && blogPageNumber <= blogPageData.totalPages;
const source = import.meta.glob('../routes/**/*.md', { eager: true, query: '?raw', import: 'default' });
const assetSource = import.meta.glob('../routes/**/*.{png,jpg,jpeg,webp,gif,svg}', {
  eager: true,
  query: '?url',
  import: 'default'
}) as Record<string, string>;
const legacyImages = import.meta.glob('../routes/**/*.{png,jpg,jpeg,webp,gif}', {
  eager: true,
  query: '?legacy-width=880',
  import: 'default'
}) as Record<string, string>;
const legacyEntry = Object.entries(source).find(([path]) => {
  const normalized = path.replace(/^.*\/routes\//, '').replace(/\/index\.md$/, '');
  return normalized === slug;
});

const cms = isBlogArchive ? null : usesCms() ? await getCmsDocument(slug) : null;
const entry = isBlogArchive ? null : cms ? cms.document : legacyEntry;
if (!entry && !isBlogArchive) Astro.response.status = 404;
if (cms?.isPreview) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}
const raw = legacyEntry?.[1] ?? '';
const frontmatterMatch = raw.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
const legacyMetadata = Object.fromEntries((frontmatterMatch?.[1] ?? '').split('\n').filter(Boolean).map((line) => {
  const index = line.indexOf(':');
  return [line.slice(0, index).trim(), line.slice(index + 1).trim().replace(/^['"]|['"]$/g, '')];
}));
const metadata: Record<string, string> = cms ? cms.document?.metadata ?? {} : legacyMetadata;
const content = cms ? cms.document?.content ?? '' : frontmatterMatch?.[2] ?? '';
const entryDirectory = cms?.document?.directory ?? legacyEntry?.[0]?.replace(/\/index\.md$/, '') ?? '';
const scriptValues = Object.fromEntries(
  [...content.matchAll(/(?:let|const)\s+(\w+)\s*=\s*['"]([^'"]*)['"]/g)].map((match) => [match[1], match[2]])
);
const expandVariables = (value: string) =>
  value.replace(/\{(\w+)\}/g, (_, key: string) => scriptValues[key] ?? metadata[key] ?? '');

const resolveMarkdownImages = (value: string) =>
  value.replace(/!\[([^\]]*)\]\(([^)\s]+)(?:\s+"([^"]*)")?\)/g, (_, alt, imagePath, imageTitle) => {
    const cleanPath = imagePath.split('?')[0].replace(/^\.\//, '');
    const requestedWidth = new URLSearchParams(imagePath.split('?')[1]).get('width');
    const assets = requestedWidth === '880' ? legacyImages : assetSource;
    const sourcePath = `${entryDirectory}/${cleanPath}`;
    const mediaKey = `${sourcePath.replace(/^\.\.\//, 'src/')}|original`;
    const mapped = (mediaManifest.assets as Record<string, { url: string; storageKey: string }>)[mediaKey];
    const resolved = cms && mapped ? mapped.url : assets[sourcePath] ?? imagePath;
    const title = imageTitle ? ` "${imageTitle}"` : '';
    return `![${alt}](${resolved}${title})`;
  });

type ContentSegment =
  | { kind: 'markdown'; html: string }
  | { kind: 'video'; id: string; title: string };

const slugger = new GithubSlugger();
const renderer = new Renderer();
const defaultImage = renderer.image;
renderer.image = function (token) {
  const image = defaultImage.call(this, token);
  // Editors select one original; delivery sizes/formats are server concerns.
  const key = token.href.match(/^\/_emdash\/api\/media\/file\/(legacy\/[a-f0-9]{64}\.(?:png|jpe?g|webp|gif|avif)|[A-Za-z0-9_-]+\.(?:png|jpe?g|webp|gif|avif))$/)?.[1];
  if (!cms || !key) return image;
  const sizes = '(max-width: 940px) calc(100vw - 60px), 880px';
  const srcset = (format: string) => [440, 880, 1760].map((width) => `${imageUrl(key, width, format)} ${width}w`).join(', ');
  const fallback = image.replace(/src="[^"]*"/, `src="${imageUrl(key)}"`)
    .replace(/\s*\/?>$/, ` srcset="${srcset('webp')}" sizes="${sizes}" width="880">`);
  return `<picture><source type="image/avif" srcset="${srcset('avif')}" sizes="${sizes}">${fallback}</picture>`;
};
renderer.heading = function ({ text, depth, tokens }) {
  const id = slugger.slug(text.replace(/<[^>]*>/g, ''));
  return `<h${depth} id="${id}"><a href="#${id}">${this.parser.parseInline(tokens)}</a></h${depth}>\n`;
};
const renderMarkdown = (value: string) => sanitizeMarkdown(expandVariables(String(marked.parse(
  value.replace(/^ {4}(?=<\/?summary[\s>])/gm, ''),
  { renderer }
))));
const segments: ContentSegment[] = [];
const videoPattern = /<Video\s+id=\{(\w+)\}\s+title=\{(\w+)\}\s*\/>/g;
let cursor = 0;
for (const match of content.matchAll(videoPattern)) {
  const index = match.index ?? 0;
  const markdown = content.slice(cursor, index).replace(/<script[\s\S]*?<\/script>/gi, '');
  if (markdown.trim()) {
    segments.push({ kind: 'markdown', html: renderMarkdown(resolveMarkdownImages(markdown)) });
  }
  segments.push({
    kind: 'video',
    id: scriptValues[match[1]] ?? '',
    title: scriptValues[match[2]] ?? ''
  });
  cursor = index + match[0].length;
}
const remainingMarkdown = content.slice(cursor).replace(/<script[\s\S]*?<\/script>/gi, '');
if (remainingMarkdown.trim()) {
  segments.push({
    kind: 'markdown',
    html: renderMarkdown(resolveMarkdownImages(remainingMarkdown))
  });
}
const isFaq = slug === 'faq';
const isPost = !!entry && slug.startsWith('blog/');
const isIntegration = !!entry && slug.endsWith('-integration');
const relatedPosts = isPost ? getRelatedPosts((await getPublishedPosts()) as IPost[], slug.slice('blog/'.length)) : [];
const breadcrumbs = isPost
  ? [
      { name: 'Home', url: '/' },
      { name: 'Blog', url: '/blog' },
      { name: metadata.title, url: Astro.url.pathname }
    ]
  : isBlogArchive
    ? [
        { name: 'Home', url: '/' },
        { name: 'Blog', url: '/blog' },
        { name: `Page ${blogPageNumber}`, url: Astro.url.pathname }
      ]
    : isIntegration
      ? [
          { name: 'Home', url: '/' },
          { name: 'Integrations', url: '/#integrations' },
          { name: metadata.title, url: Astro.url.pathname }
        ]
      : [];
const description = !entry ? 'Page not found: 404' : metadata.description;
const archiveTitle = `Blog about effective email checking & communication — page ${blogPageNumber}`;
const archiveDescription = 'Older Mailcheck articles about email checking, deliverability, marketing, and effective communication.';
const pageTitle = isBlogArchive ? archiveTitle : metadata.title || 'Page not found';
const pageDescription = isBlogArchive ? archiveDescription : description;
const archiveCanonical = isBlogArchive ? `/blog/${blogPageNumber}` : '';
const thumbnailPath = metadata.thumbnailImg?.split('?')[0].replace(/^\.\//, '');
const thumbnailAsset = assetSource[`${entryDirectory}/${thumbnailPath}`];
const thumbnailIsSvg = /\.svg$/i.test(thumbnailPath ?? '');
const hasThumbnail = Boolean(!thumbnailIsSvg && metadata.thumbnailImg && (/^(?:https?:\/\/|\/)/.test(metadata.thumbnailImg) || thumbnailAsset));
const thumbnail = hasThumbnail ? (/^(?:https?:\/\/|\/)/.test(metadata.thumbnailImg) ? metadata.thumbnailImg : thumbnailAsset) : '/preview.jpeg';
const pageUrl = new URL(archiveCanonical || metadata.canonical || Astro.url.pathname, data.siteUrl).href;
const thumbnailUrl = new URL(thumbnail, data.siteUrl).href;
const breadcrumbSchema = breadcrumbs.length ? breadcrumbListSchema(breadcrumbs) : null;
const videoSchemas = segments.filter((segment): segment is Extract<ContentSegment, { kind: 'video' }> => segment.kind === 'video')
  .map((video) => videoObjectSchema({
    id: video.id,
    title: video.title,
    description: pageDescription,
    date: metadata.date,
    pageUrl
  }));
const cleanText = (value: string) => value
  .replace(/<script[\s\S]*?<\/script>/gi, '')
  .replace(/<Video[^>]*\/>/gi, '')
  .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
  .replace(/<[^>]+>/g, ' ')
  .replace(/[\*_`>#-]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const faqQuestions = isFaq ? [...content.matchAll(/<details>\s*<summary>([\s\S]*?)<\/summary>([\s\S]*?)<\/details>/gi)]
  .map((match) => ({ question: cleanText(match[1]), answer: cleanText(match[2]) }))
  .filter(({ question, answer }) => question && answer) : [];
const schemas = isBlogArchive
  ? [websiteSchema, { ...blogSchema, url: pageUrl, name: pageTitle, description: pageDescription }, ...(breadcrumbSchema ? [breadcrumbSchema] : [])]
  : !entry
    ? [websiteSchema]
    : isFaq
       ? [websiteSchema, faqPageSchema(pageUrl, faqQuestions), ...videoSchemas]
       : isPost
         ? [
             blogPostingSchema({ url: pageUrl, title: metadata.title, description, image: hasThumbnail ? thumbnailUrl : undefined, date: metadata.date }),
             websiteSchema,
             ...(breadcrumbSchema ? [breadcrumbSchema] : []),
             ...videoSchemas
           ]
         : [websiteSchema, webPageSchema({ url: pageUrl, name: metadata.title, description, image: thumbnailUrl }), ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...videoSchemas];
---
<SiteLayout title={pageTitle} description={pageDescription} canonical={isBlogArchive ? archiveCanonical : entry ? metadata.canonical : '/'}
  pathname={isBlogArchive || entry ? Astro.url.pathname : '/404'} noindex={!entry && !isBlogArchive || !!cms?.isPreview || metadata.noindex === 'true'} {isPost}
  thumbnail={isFaq ? '/preview.jpeg' : thumbnail} {schemas}>
  {isBlogArchive && <Fragment slot="head">
    <link rel="prev" href={`https://mailcheck.co${blogPageNumber === 2 ? '/blog' : `/blog/${blogPageNumber - 1}`}`} />
    {blogPageNumber < blogPageData!.totalPages && <link rel="next" href={`https://mailcheck.co/blog/${blogPageNumber + 1}`} />}
  </Fragment>}
  {!entry && !isBlogArchive && <meta slot="head" http-equiv="refresh" content="5;https://mailcheck.co/" />}
  {isBlogArchive ? (
    <Blog posts={blogPageData!.posts} page={blogPageNumber} totalPages={blogPageData!.totalPages} />
  ) : entry ? (
    isFaq ? (
      <FaqLayout client:load title={metadata.title} canonical={metadata.canonical} noindex={metadata.noindex === 'true'}>
        {segments.map((segment) =>
          segment.kind === 'video' ? (
            <Video client:visible id={segment.id} title={segment.title} />
          ) : (
            <Fragment set:html={segment.html} />
          )
        )}
      </FaqLayout>
    ) : (
      <ArticleLayout title={metadata.title} description={metadata.description} canonical={metadata.canonical} noindex={metadata.noindex === 'true'} pathname={Astro.url.pathname} breadcrumbs={breadcrumbs} relatedPosts={relatedPosts}>
        {segments.map((segment) =>
          segment.kind === 'video' ? (
            <Video client:visible id={segment.id} title={segment.title} />
          ) : (
            <Fragment set:html={segment.html} />
          )
        )}
      </ArticleLayout>
    )
  ) : <NotFound />}
  {(isBlogArchive || (entry && (slug.startsWith('blog/') || slug === 'affiliates'))) && <ContactUs client:visible />}
</SiteLayout>
<style is:global>
  .services-table { width: 100%; border-collapse: collapse; color: #ffffff; }
  .services-table th, .services-table td { padding: 8px; text-align: left; vertical-align: top; }
  .services-table thead th { font-weight: bold; font-size: 1.4em; text-align: center; }
</style>
