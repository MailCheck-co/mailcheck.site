{
  "name": "mailcheck",
  "version": "3.0.0",
  "description": "An application to clean your subscription list from bounces, and enrich data about customers.",
  "scripts": {
    "cms:prepare": "node scripts/prepare-cms-seed.mjs",
    "cms:check": "node scripts/prepare-cms-seed.mjs --check && emdash seed --validate",
    "cms:media": "node scripts/prepare-cms-media.mjs",
    "cms:activate": "node scripts/activate-cms.mjs",
    "cms:tracking": "node scripts/tracking-targets.mjs",
    "cms:media-normalize": "node scripts/normalize-cms-media.mjs",
    "readiness:secrets": "node scripts/check-worker-readiness.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:watch": "astro check --watch",
    "test:backend": "node --test tests/backend.test.mjs",
    "test:site": "node --test tests/site.test.mjs",
    "test:site-http": "node --test tests/site-http.test.mjs",
    "test:images": "node --test tests/legacy-images.test.mjs",
    "test:cms": "node --test tests/cms-seed.test.mjs",
    "test:cms-rendering": "node --test tests/cms-rendering.test.mjs",
    "test:cms-lifecycle": "node --test tests/cms-lifecycle.test.mjs",
    "test:cms-media": "node --test tests/cms-media.test.mjs",
    "test:media-images": "node --test tests/media-images.test.mjs",
    "test:readiness": "node --test tests/worker-readiness.test.mjs",
    "test:tracking": "node --test tests/tracking-targets.test.mjs",
    "lint": "prettier --check . && eslint --ignore-path .gitignore . && astro check",
    "lint:style": "stylelint \"src/**/*.+(scss|css|svelte)\"",
    "lint:style:fix": "stylelint \"src/**/*.+(scss|css|svelte)\" --fix",
    "format": "prettier --write --plugin-search-dir=. .",
    "test": "node --test tests/backend.test.mjs tests/legacy-images.test.mjs tests/cms-seed.test.mjs tests/cms-rendering.test.mjs tests/media-images.test.mjs tests/worker-readiness.test.mjs tests/edge.test.mjs tests/tracking-targets.test.mjs",
    "deploy:staging": "astro build && wrangler deploy",
    "deploy:production": "node scripts/confirm-production-deploy.mjs && node scripts/check-worker-readiness.mjs && CLOUDFLARE_ENV=production astro build && wrangler deploy",
    "spell": "npx cspell lint \"**/*.{ts,svelte,scss,md}\" -c configs/.cspell.json --no-progress",
    "optimize-svg": "find ./src ./static -name '*.svg' -print0 | xargs -0 -P16 -L20 npx svgo"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@nodeart/stylelint-config-nodeart": "^0.0.10",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.56.0",
    "autoprefixer": "^10.4.13",
    "cssnano": "^5.1.15",
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.6.0",
    "jsonc-parser": "3.3.1",
    "postcss": "^8.5.31",
    "postcss-load-config": "^4.0.1",
    "postcss-scss": "^4.0.6",
    "prettier": "~2.8.8",
    "prettier-plugin-svelte": "^2.9.0",
    "sass": "^1.105.2",
    "schema-dts": "^1.1.0",
    "stylelint": "^14.16.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-prettier-scss": "^0.0.1",
    "svelte": "^5.43.6",
    "svelte-check": "^4.3.3",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.5.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.1"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/react": "^7.1.0",
    "@astrojs/svelte": "^9.1.0",
    "@emdash-cms/cloudflare": "^1.3.0",
    "@emnapi/runtime": "^1.11.3",
    "@fontsource/fira-mono": "^4.5.10",
    "@fontsource/roboto": "^4.5.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "^7.4.0",
    "emdash": "^1.3.0",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "kysely": "^0.29.7",
    "kysely-d1": "^0.4.0",
    "marked": "^17.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.33.5",
    "svelte-inview": "^3.0.2",
    "svelte-slidy": "^2.8.7"
  },
  "stylelint": {
    "extends": [
      "@nodeart/stylelint-config-nodeart",
      "stylelint-config-html/html",
      "stylelint-config-html/svelte",
      "stylelint-config-prettier-scss"
    ],
    "ignoreFiles": [
      "src/styles/normalize.+(scss|css)",
      "src/styles/fonts.+(scss|css)",
      "src/styles/vars.+(scss|css)"
    ],
    "rules": {
      "no-descending-specificity": null,
      "plugin/no-low-performance-animation-properties": null,
      "selector-pseudo-class-no-unknown": [
        true,
        {
          "ignorePseudoClasses": [
            "global"
          ]
        }
      ]
    }
  },
  "url": "https://mailcheck.co/",
  "engines": {
    "node": ">=22.22.0"
  },
  "emdash": {
    "seed": "seed/seed.json"
  }
}
